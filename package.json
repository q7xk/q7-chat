    "react-dom": "^19.3.1",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.21",
    "eslint": "^9.8.0",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "^6.2.6",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.17",
    "typescript": "^5.6.0",
    "vitest": "5.1.0",
    "prettier": "^3.5.0"
